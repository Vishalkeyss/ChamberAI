# 121Meet Chamber — frontend build configuration (read only in src/core/config/app-config.ts)
# Copy to .env.production / .env.staging for builds. No secrets here: everything is public in the bundle.

# Root domain; chamber sites are <subdomain>.<VITE_PLATFORM_DOMAIN>. Not needed for local *.localhost dev.
VITE_PLATFORM_DOMAIN=

# API origin. Leave EMPTY when the API is served on the same host under /api (recommended).
VITE_API_URL=
