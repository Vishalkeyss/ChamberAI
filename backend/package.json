{
  "name": "chamber-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "echo \"Use npm run deploy:staging or npm run deploy:production\" && exit 1",
    "deploy:staging": "wrangler deploy --minify --env staging",
    "deploy:production": "wrangler deploy --minify --env production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/test/*.test.ts",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^26.6.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "wrangler": "^3.111.0"
  }
}
